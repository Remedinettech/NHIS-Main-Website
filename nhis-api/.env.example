# nhis-api server-only configuration. Copy to .env (git-ignored). Never commit real values and never expose
# anything here through VITE_* variables.

# --- Database (PostgreSQL) ---------------------------------------------------------------------------------
# Runtime connection: dedicated application role with data access only (SELECT/INSERT/UPDATE/DELETE, no DDL).
DATABASE_URL="postgresql://APP_ROLE:CHANGE_ME@127.0.0.1:5432/DATABASE_NAME?schema=public"
# Migration connection: schema owner role, used only by `prisma migrate deploy` (npm run db:migrate).
DIRECT_URL="postgresql://OWNER_ROLE:CHANGE_ME@127.0.0.1:5432/DATABASE_NAME?schema=public"

# --- File storage ------------------------------------------------------------------------------------------
# Local-disk driver (the only implemented one). Default root: nhis-api/storage (git-ignored).
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_DIR=storage
# Upload limits in bytes (defaults: 25 MB documents, 5 MB images).
# UPLOAD_MAX_DOCUMENT_BYTES=26214400
# UPLOAD_MAX_IMAGE_BYTES=5242880

# --- Public API ----------------------------------------------------------------------------------------------
# Date reported as `capturedAt` for the imported snapshot content.
# NHIS_SNAPSHOT_DATE=2026-10-07

# --- Admin API (defaults shown) ------------------------------------------------------------------------
# Comma separated browser origins allowed to call the admin API (default: the Vite dev origins).
# ADMIN_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# ADMIN_COOKIE_SECURE=false          # always secure when NODE_ENV=production
# ADMIN_COOKIE_SAMESITE=lax          # lax | strict
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_ABSOLUTE_HOURS=8
# ADMIN_TRUSTED_PROXY_HOPS=1
# ADMIN_LOGIN_WINDOW_MINUTES=15
# ADMIN_LOGIN_MAX_PER_EMAIL_IP=5
# ADMIN_LOGIN_MAX_PER_IP=30
# ADMIN_MAX_BODY_BYTES=262144
# First administrator (npm run admin:bootstrap -w nhis-api). Prefer the hidden prompt over putting a password here.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_NAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Tests ---------------------------------------------------------------------------------------------------
# Integration tests require an isolated disposable database; do not use an application database.
# NHIS_TEST_SCHEMA=nhis_test

# Excel metadata imports: REQUIRED for the import feature in every environment (no default exists, imports are refused
# without it): a random secret of at least 32 characters, identical on every API worker and stable across restarts.
# Required for imports in every environment; no default key is used.
# ADMIN_IMPORT_SIGNING_KEY=
# ADMIN_IMPORT_MAX_BYTES=2000000
# ADMIN_IMPORT_MAX_ROWS=500

# Uploaded MP4s: configurable downward, hard maximum 25 MiB (IIS request limit is 30 MB).
# UPLOAD_MAX_VIDEO_BYTES=26214400
