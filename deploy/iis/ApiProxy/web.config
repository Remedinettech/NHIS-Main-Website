<?xml version="1.0" encoding="UTF-8"?>
<!--
  TN-NHIS API reverse proxy: IIS application "TNNHISApi" (J:\TN_NHIS_WEBSITE\ApiProxy).
  Requires the IIS URL Rewrite module and Application Request Routing (ARR) with the proxy enabled
  (IIS Manager > server node > Application Request Routing Cache > Server Proxy Settings > Enable proxy).

  Browser:  https://3.109.241.251/TNNHISApi/api/v1/...
  Inside this application the path is:  api/v1/...
  Forwarded to Next.js:  http://127.0.0.1:3001/api/v1/...

  Only the external IIS application prefix (/TNNHISApi) is removed. Next.js has no basePath.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="TNNHIS API proxy" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" appendQueryString="true" logRewrittenUrl="false" />
        </rule>
        <!-- Nothing but /api/... is proxied. -->
        <rule name="TNNHIS API: everything else" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>

    <!-- The admin API uses PUT and DELETE. The WebDAV module would answer them with 405, so it is removed here. -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>

    <!-- Uploads: documents up to 25 MB (UPLOAD_MAX_DOCUMENT_BYTES) plus multipart overhead. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
