# TN-NHIS API configuration for Windows Server / IIS.
#
# Copy to  J:\TN_NHIS_WEBSITE\Backend\nhis-api\.env  on the server and replace every <PLACEHOLDER>.
# This file is read by Next.js, Prisma and the maintenance commands. It is SERVER-ONLY:
#   - never copy it into Client, Admin or ApiProxy (those folders are public),
#   - never commit it, e-mail it or put these values in any VITE_* variable,
#   - restrict its permissions (see docs/IIS-DEPLOYMENT.md, "Permissions").
# The variable names below are exactly the ones the code reads. NODE_ENV=production is set by the service definition.

# --- Database (hosted PostgreSQL) ---------------------------------------------------------------------------------
# Runtime connection: the application role (data access only). Percent-encode special characters in the password.
DATABASE_URL="postgresql://tn_nhis_app:<APP_ROLE_PASSWORD>@<DB_HOST>:5432/tn_nhis_website?schema=public"
# Migration/owner connection. NOT needed to run the API. Leave it commented out on the server unless a DBA-approved
# migration is being applied with:  npm run db:migrate -w nhis-api   (this project never migrates automatically).
# DIRECT_URL="postgresql://tn_nhis_owner:<OWNER_ROLE_PASSWORD>@<DB_HOST>:5432/tn_nhis_website?schema=public"

# --- Uploaded documents and images ----------------------------------------------------------------------------------
# Persistent store outside the release folder. Keep the file names exactly as restored (they are the storage keys).
FILE_STORAGE_DRIVER=local
FILE_STORAGE_DIR=J:\TN_NHIS_WEBSITE\Uploads
UPLOAD_MAX_DOCUMENT_BYTES=26214400
UPLOAD_MAX_IMAGE_BYTES=5242880

# --- Admin sign-in behind IIS ---------------------------------------------------------------------------------------
# Browser origin(s) that serve the admin site. Must be HTTPS and must match exactly (scheme, host, port, no path).
# Mutating admin requests from any other origin are refused (CSRF protection).
ADMIN_ALLOWED_ORIGINS=https://3.109.241.251
# Application-specific session cookie. The path must cover the EXTERNAL API path (the IIS application name).
ADMIN_COOKIE_NAME=tnnhis_admin_session
ADMIN_COOKIE_PATH=/TNNHISApi
# Cookies are always Secure in production (NODE_ENV=production). Admin sign-in therefore requires an HTTPS binding.
# ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=lax
# Number of reverse proxies between the browser and Next.js: IIS ARR = 1. The client address is read from the
# right-hand end of X-Forwarded-For. Do not raise this unless another proxy/load balancer is added in front of IIS.
ADMIN_TRUSTED_PROXY_HOPS=1

# --- Session and sign-in limits (defaults shown) --------------------------------------------------------------------
# ADMIN_SESSION_IDLE_MINUTES=30
# ADMIN_SESSION_ABSOLUTE_HOURS=8
# ADMIN_LOGIN_WINDOW_MINUTES=15
# ADMIN_LOGIN_MAX_PER_EMAIL_IP=5
# ADMIN_LOGIN_MAX_PER_IP=30
# ADMIN_MAX_BODY_BYTES=262144

# --- Optional -------------------------------------------------------------------------------------------------------
# Date reported as "capturedAt" for the imported content.
# NHIS_SNAPSHOT_DATE=2026-10-07
